{
  "name": "aaronscheatsheet",
  "displayName": "Cheats Sidekick",
  "description": "\"Built for Me, Too Good to Keep to Myself.\" Search, insert, and save Cheats snippets, Tasks, Brain entries, and Project cards without leaving the editor.",
  "version": "0.1.0",
  "publisher": "AaronTrotter",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronTrotter/cheats-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/AaronTrotter/cheats-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cheats.setApiKey",
        "title": "Cheats Sidekick: Set API Key"
      },
      {
        "command": "cheats.searchCheats",
        "title": "Cheats Sidekick: Search Cheats"
      },
      {
        "command": "cheats.createCheat",
        "title": "Cheats Sidekick: Create Cheat"
      },
      {
        "command": "cheats.searchTasks",
        "title": "Cheats Sidekick: Search Tasks"
      },
      {
        "command": "cheats.createTask",
        "title": "Cheats Sidekick: Create Task"
      },
      {
        "command": "cheats.searchBrain",
        "title": "Cheats Sidekick: Search Brain"
      },
      {
        "command": "cheats.createBrain",
        "title": "Cheats Sidekick: Create Brain Entry"
      },
      {
        "command": "cheats.insertGuides",
        "title": "Cheats Sidekick: Insert Guides (Brief + Rules)"
      },
      {
        "command": "cheats.searchProjectCards",
        "title": "Cheats Sidekick: Search Project Cards"
      },
      {
        "command": "cheats.createProjectCard",
        "title": "Cheats Sidekick: Create Project Card"
      }
    ],
    "keybindings": [
      {
        "command": "cheats.searchCheats",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorTextFocus"
      },
      {
        "command": "cheats.createCheat",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus"
      },
      {
        "command": "cheats.searchTasks",
        "key": "ctrl+alt+shift+/",
        "mac": "cmd+alt+shift+/",
        "when": "editorTextFocus"
      },
      {
        "command": "cheats.createTask",
        "key": "ctrl+alt+shift+.",
        "mac": "cmd+alt+shift+.",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Cheats Sidekick",
      "properties": {
        "cheats.baseUrl": {
          "type": "string",
          "default": "https://cheats.cloud",
          "description": "Base URL of the Cheats instance to search (no trailing slash). Only change this if you run your own fork of Cheats elsewhere."
        },
        "cheats.limit": {
          "type": "number",
          "default": 10,
          "description": "Max number of suggestions to fetch per search."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
